# ---------------------------------------------------------------------------
# MARTA MATE environment variables
#
# Copy this file to .env.local and fill in only what you have:
#     cp .env.example .env.local
#
# The app runs with ALL of these blank. Each missing key just means that
# integration shows "demo" in the header instead of "live".
#
# Restart `npm run dev` after editing this file — env vars are read at startup.
# ---------------------------------------------------------------------------

# --- Auth0 -----------------------------------------------------------------
# Public by design (VITE_ values are compiled into the browser bundle).
# Auth0 Dashboard > Applications > your SPA > Settings.
# Leave blank to use the clearly labelled local demo session instead.
VITE_AUTH0_DOMAIN=
VITE_AUTH0_CLIENT_ID=
# Only if you add an Auth0 API. Leave blank otherwise.
VITE_AUTH0_AUDIENCE=

# --- Google Gemini ---------------------------------------------------------
# SERVER ONLY. Never rename this to VITE_GEMINI_API_KEY — that would ship your
# key to every visitor. Get one at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional. Defaults to gemini-2.5-flash.
GEMINI_MODEL=

# --- ElevenLabs ------------------------------------------------------------
# SERVER ONLY. Key: elevenlabs.io > profile menu > API Keys.
# Voice ID: elevenlabs.io > Voices > pick a voice > copy its ID.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
# Optional. Defaults to eleven_multilingual_v2.
ELEVENLABS_MODEL_ID=

# --- Tiger Data / PostgreSQL ----------------------------------------------
# SERVER ONLY. The full connection string from your Tiger Data service.
# Format: postgres://user:password@host:port/dbname?sslmode=require
DATABASE_URL=
