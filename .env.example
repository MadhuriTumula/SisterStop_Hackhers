# App
VITE_APP_NAME=MARTA MATE
VITE_APP_ENV=development

# Auth0 (public by design — safe to expose in the browser build)
VITE_AUTH0_DOMAIN=
VITE_AUTH0_CLIENT_ID=
VITE_AUTH0_AUDIENCE=
VITE_AUTH0_CALLBACK_URL=http://localhost:5173

# Gemini — server only. NEVER prefix with VITE_.
GEMINI_API_KEY=

# ElevenLabs — server only. NEVER prefix with VITE_.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=

# Tiger Data / PostgreSQL — server only.
DATABASE_URL=

# Feature flags
VITE_ENABLE_TIGER_PULSE=true
VITE_ENABLE_LIVE_AUDIO=true
